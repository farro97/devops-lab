# Terraform
**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfplan
tfplan
plan.txt

# Your real values: keep these out of Git
*.tfvars
!*.tfvars.example
backend.hcl
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Keep the provider lock file: it pins exact provider versions for everyone
!.terraform.lock.hcl

# OS / editor
.DS_Store
.idea/
.vscode/

# Python (app/)
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.venv/
venv/
